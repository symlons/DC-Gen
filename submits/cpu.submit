#!/bin/bash
#SBATCH --job-name=ct_rate_hdf5
#SBATCH --account=cai_ivs
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=64
#SBATCH --mem=128G
#SBATCH --time=7200
#SBATCH --output=/cluster/projects/2025_stmd_VT_diff/logs/ct_hdf5_%j.out
#SBATCH --error=/cluster/projects/2025_stmd_VT_diff/logs/ct_hdf5_%j.err
#SBATCH --mail-type=END,FAIL

echo "=========================================="
echo "Job ID:     $SLURM_JOB_ID"
echo "Node:       $SLURMD_NODENAME"
echo "CPUs:       $SLURM_CPUS_PER_TASK"
echo "Started:    $(date)"
echo "=========================================="

# ── Paths ──────────────────────────────────────────────────────────────────
DATA_SRC="/cluster/projects/ac3t/data/ac3t_ct_rate/processed/train"
SCRATCH="/scratch/$SLURM_JOB_ID"
OUT_H5="/cluster/projects/2025_stmd_VT_diff/data/ct_dataset_256.h5"
LOG_DIR="/cluster/projects/2025_stmd_VT_diff/logs"

mkdir -p "$SCRATCH" "$LOG_DIR" "$(dirname $OUT_H5)"

# ── Step 1: Copy data to local scratch ────────────────────────────────────
echo "[$(date +%T)] Copying data to local scratch..."
rsync -a --info=progress2 "$DATA_SRC/" "$SCRATCH/data/"
echo "[$(date +%T)] Copy done. $(find $SCRATCH/data -name '*.nii.gz' | wc -l) files."

# ── Step 2: Pre-decompress .nii.gz → .nii ─────────────────────────────────
echo "[$(date +%T)] Pre-decompressing .nii.gz files..."
find "$SCRATCH/data" -name "*.nii.gz" | \
    xargs -P 56 -I{} bash -c 'gunzip -k "$1" 2>/dev/null || true' _ {}
echo "[$(date +%T)] Decompressed $(find $SCRATCH/data -name '*.nii' | wc -l) files."

# ── Step 3: Run conversion ─────────────────────────────────────────────────
echo "[$(date +%T)] Starting HDF5 conversion..."
python3 /cluster/projects/2025_stmd_VT_diff/scripts/create_hdf.py \
    --root    "$SCRATCH/data" \
    --out     "$SCRATCH/ct_dataset_256.h5" \
    --workers 56 \
    --ext     ".nii"

# ── Step 4: Move output to final destination ───────────────────────────────
echo "[$(date +%T)] Moving HDF5 to final location..."
mv "$SCRATCH/ct_dataset_256.h5" "$OUT_H5"

# ── Cleanup ────────────────────────────────────────────────────────────────
echo "[$(date +%T)] Cleaning scratch..."
rm -rf "$SCRATCH"

echo "=========================================="
echo "Done:   $(date)"
echo "Output: $OUT_H5"
echo "=========================================="
