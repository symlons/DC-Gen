#!/bin/bash

#SBATCH --account=cai_ivs
#SBATCH --partition=gpu_top
#SBATCH --gres=gpu:h200sxm:1
#SBATCH --cpus-per-task=32
#SBATCH --mem=128G
#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --job-name=flow_bf16_lat128
#SBATCH --output=/cluster/home/kostfab1/DC-Gen/logs/flow_bf16_adaptive128/%x_%j.out
#SBATCH --error=/cluster/home/kostfab1/DC-Gen/logs/flow_bf16_adaptive128/%x_%j.err
#SBATCH --chdir=/cluster/home/kostfab1/DC-Gen/
#SBATCH --signal=B:SIGUSR1@90
#SBATCH --requeue
#SBATCH --open-mode=append

set -euo pipefail

BASE_EXPERIMENT="configs/experiments/flow_bf16_adaptive128_latents.yaml"
RUNTIME_EXPERIMENT="/cluster/home/kostfab1/DC-GEN/job_submits/flow_bf16_adaptive128_latents_runtime.yaml"

handle_signal() {
  echo "STOP SIGNAL DETECTED - REQUEUING JOB"
  if [ -n "${child_pid:-}" ]; then
    kill -INT "$child_pid" || true
    sleep 10
    if kill -0 "$child_pid" 2>/dev/null; then
      kill -KILL "$child_pid" || true
    fi
  fi
  scontrol requeue "$SLURM_JOB_ID"
  exit 0
}
trap 'handle_signal' USR1

echo "Running on $(hostname)"
echo "Job ID: $SLURM_JOB_ID"
echo "Base experiment: $BASE_EXPERIMENT"
echo "Starting at $(date)"

module load cuda/13.2.0
source /cluster/home/kostfab1/dev2/bin/activate
export PYTHONPATH=/cluster/home/kostfab1/DC-Gen/compat:${PYTHONPATH:-}
mkdir -p /cluster/home/kostfab1/DC-Gen/logs/flow_bf16_adaptive128 /cluster/home/kostfab1/DC-GEN/job_submits

python3 scripts/compute_latent_stats_config.py "$BASE_EXPERIMENT" "$RUNTIME_EXPERIMENT"

python3 -c "import torch; assert torch.cuda.is_available(), 'CUDA not visible'; print('CUDA visible', torch.cuda.get_device_name(0), 'count=', torch.cuda.device_count())"
python3 -c "from train_dit_3d import load_config; cfg = load_config('$RUNTIME_EXPERIMENT'); print('Config preflight OK', cfg.experiment.name, 'dtype=', cfg.training.dtype, 'autocast=', cfg.training.autocast_dtype, 'in_channels=', cfg.model.in_channels, 'latent_mean=', cfg.objective.latent_mean, 'latent_std=', cfg.objective.latent_std)"

python3 train_dit_3d.py --experiment "$RUNTIME_EXPERIMENT" &
child_pid=$!
wait "$child_pid"
