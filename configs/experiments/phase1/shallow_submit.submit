#!/bin/bash

#SBATCH --account=cai_ivs
#SBATCH --partition=gpu_top
#SBATCH --gres=gpu:h200sxm:1
#SBATCH --cpus-per-task=32
#SBATCH --mem=128G
#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --job-name=3d_dc_ae_phase1_ssim

#SBATCH --output=/cluster/home/kostfab1/DC-Gen/logs/ssim/%A/%N.out
#SBATCH --error=/cluster/home/kostfab1/DC-Gen/logs/ssim/%A/%N.err
#SBATCH --chdir=/cluster/home/kostfab1/DC-Gen/
#SBATCH --signal=B:SIGUSR1@90
#SBATCH --requeue
#SBATCH --open-mode=append

handle_signal() {
  echo "STOP SIGNAL DETECTED - REQUEUING JOB"

  if [ -n "$child_pid" ]; then
    kill -INT "$child_pid"
    sleep 10
    if kill -0 "$child_pid" 2>/dev/null; then
      kill -KILL "$child_pid"
    fi
  fi

  scontrol requeue $SLURM_JOB_ID
  exit 0
}
trap 'handle_signal' USR1

echo "Running on $(hostname)"
echo "Job ID: $SLURM_JOB_ID"
echo "Starting at $(date)"

module load cuda/12.9.1

source /cluster/home/kostfab1/dev2/bin/activate

NUM_GPUS=${SLURM_GPUS_ON_NODE:-1}

for port in 8972 8973 8974 8975; do
  if ! ss -tuln | grep -q ":$port "; then
    MASTER_PORT=$port
    break
  fi
done

if [ -z "$MASTER_PORT" ]; then
  echo "No free port found in range"
  exit 1
fi

export MASTER_PORT
export MASTER_ADDR=$(hostname)

OMP_NUM_THREADS=1 torchrun --nproc_per_node=$NUM_GPUS structure.py --experiment phase1/dc-ae-f32c32-in-1.0_3d-shallow --model f32c32_shallow_narrow &

child_pid=$!
wait $child_pid
